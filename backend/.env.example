# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.

# Una o varias API keys de Gemini separadas por coma (se rotan si una falla).
GEMINI_API_KEYS=tu_key_1,tu_key_2

# Puerto HTTP (los hostings como Render/Cloud Run lo definen solos).
PORT=8080

# Orígenes permitidos para una versión web, separados por coma. Vacío = ninguno
# (la app de Android no lo necesita).
# ALLOWED_ORIGINS=https://tu-dominio.com

# En producción: GIN_MODE=release

# Límites de pedidos a la API (por minuto). 0 = sin límite.
RATE_LIMIT_POR_MINUTO=10
RATE_LIMIT_GLOBAL_POR_MINUTO=60

# Ruta del archivo de caché (por defecto cache.json en la carpeta actual).
# CACHE_FILE=/tmp/cache.json

# Proyecto de Firebase: si está definido, la API exige el ID token del usuario
# (Authorization: Bearer ...). Vacío = sin login (útil para probar con curl).
# FIREBASE_PROJECT_ID=travel-planner-4712c

# Consultas a la IA por día (por usuario y en total). 0 = sin límite.
CUOTA_DIARIA_POR_USUARIO=60
CUOTA_DIARIA_GLOBAL=3000
